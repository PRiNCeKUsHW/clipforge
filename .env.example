# =====================================================================
# ClipForge configuration. Copy to `.env` and fill in the blanks:
#     copy .env.example .env        (Windows cmd / PowerShell)
#     cp .env.example .env          (bash)
# `.env` is git-ignored. Never commit real secrets.
# Comments must be on their own line (no inline "# ..." after a value).
# =====================================================================

# ---------- App / security ----------
APP_ENV=development
# Signs login tokens (JWT). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# Encrypts OAuth tokens for YouTube/Instagram (used from Phase 5). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Comma-separated list of origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000
# Cookie settings for the login cookie. In production over HTTPS with the
# frontend on another domain use COOKIE_SECURE=true and COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---------- Frontend ----------
# Where the browser reaches the API
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Postgres ----------
POSTGRES_USER=clipforge
POSTGRES_PASSWORD=clipforge
POSTGRES_DB=clipforge
# psycopg (v3) driver works for both the async API and the sync worker
DATABASE_URL=postgresql+psycopg://clipforge:clipforge@postgres:5432/clipforge

# ---------- Redis (Celery broker + live progress pub/sub) ----------
REDIS_URL=redis://redis:6379/0

# ---------- Object storage (SeaweedFS locally, Cloudflare R2 in production) ----------
# Address the containers use to reach storage
S3_ENDPOINT_URL=http://s3:8333
# Address your *browser* uses (presigned upload/download URLs are signed for it)
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=clipforge
S3_SECRET_KEY=clipforge-dev-secret
S3_BUCKET=clipforge
# Use "auto" for Cloudflare R2
S3_REGION=us-east-1
MAX_UPLOAD_MB=4096
MAX_VIDEO_MINUTES=180

# ---------- Gemini (highlight selection, the only cloud API) ----------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
HIGHLIGHT_MIN_SECONDS=20
# Keep under 60: YouTube blocks Shorts longer than 1 minute that have a copyright claim
HIGHLIGHT_MAX_SECONDS=59
HIGHLIGHT_MIN_CLIPS=5
HIGHLIGHT_MAX_CLIPS=10
# Transcripts longer than this are split into overlapping chunks
HIGHLIGHT_CHUNK_THRESHOLD_SECONDS=3600
HIGHLIGHT_CHUNK_SECONDS=1500
HIGHLIGHT_CHUNK_OVERLAP_SECONDS=120
# Also send sampled video frames to Gemini: auto (only for low-dialogue videos) | true | false
HIGHLIGHT_USE_FRAMES=auto

# ---------- Local transcription (faster-whisper) ----------
# auto = use CUDA if an NVIDIA GPU is visible inside the container, else CPU
WHISPER_DEVICE=auto
# auto = "small" on CPU, "large-v3-turbo" on GPU. Other options: tiny, base, medium, large-v3
WHISPER_MODEL=auto
# auto = int8 on CPU, float16 on GPU
WHISPER_COMPUTE_TYPE=auto
# 5 = most accurate; 1 = greedy decoding, about 2x faster (good for long videos on a small GPU)
WHISPER_BEAM_SIZE=5
# Leave blank to auto-detect the spoken language (e.g. set "en" to force English)
WHISPER_LANGUAGE=
# Optional WhisperX refinements (requires building the worker with INSTALL_WHISPERX=true)
ALIGN_WORDS=false
DIARIZE=false
# Free Hugging Face token, needed only for DIARIZE=true (accept the pyannote model terms first)
HF_TOKEN=

# ---------- YouTube downloads (yt-dlp) ----------
YTDLP_MAX_HEIGHT=1080
# Optional path *inside the worker container* to a cookies.txt (helps with "confirm you're not a bot")
YTDLP_COOKIES_FILE=

# ---------- Worker housekeeping ----------
# Delete local scratch files (downloaded source, audio) once a project is ready
CLEANUP_WORK_FILES=true

# ---------- Rendering (Remotion render service) ----------
RENDERER_URL=http://renderer:3100
# Frames rendered in parallel by headless Chrome (lower it if Docker runs out of memory)
RENDER_CONCURRENCY=3
# Default caption style for new clips: bold | karaoke | minimal | beast
DEFAULT_CAPTION_STYLE=bold
# Remotion is free for individuals/small teams; companies set their license key here
REMOTION_LICENSE_KEY=

# ---------- Smart 9:16 reframe ----------
# Face detection samples per second of video
REFRAME_SAMPLE_FPS=3
# mediapipe (accurate, default) | haar (OpenCV fallback)
REFRAME_DETECTOR=mediapipe
# Two people side by side -> split screen: auto | true | false
REFRAME_SPLIT_SCREEN=auto

# ---------- Publishing (Phase 5) ----------
# Where the browser returns after connecting an account, and this API's public address
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
# Google Cloud OAuth client (YouTube Data API v3). Redirect URI: {API_PUBLIC_URL}/api/oauth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Meta app (Instagram Graph API). Redirect URI: {API_PUBLIC_URL}/api/oauth/instagram/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
# Instagram downloads videos from a public URL. Set to your public storage base (e.g. an R2
# custom domain) or leave empty to use presigned URLs from S3_PUBLIC_ENDPOINT_URL.
PUBLIC_MEDIA_BASE_URL=

# ---------- Production only (docker-compose.prod.yml) ----------
# APP_DOMAIN=app.example.com
# API_DOMAIN=api.example.com
# WHISPER_GPU=false
